          "label": "big",
          "required": false,
          "visibleWhen": {
            "field": "n",
            "operator": "gt",
            "value": 10
          }
        },
        {
          "key": "listed",
          "type": "text",
          "label": "listed",
          "required": false,
          "visibleWhen": {
