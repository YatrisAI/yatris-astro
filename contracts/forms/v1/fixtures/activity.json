  {
    "name": "temporal comparisons and choice lists",
    "declaration": {
      "contractVersion": 1,
      "key": "contact",
      "name": "お問い合わせ",
      "locale": "ja",
      "fields": [
        {
          "key": "d",
          "type": "date",
          "label": "d",
          "required": false
        },
        {
          "key": "t",
          "type": "time",
          "label": "t",
          "required": false
        },
        {
          "key": "c",
          "type": "checkboxes",
          "label": "c",
          "required": false,
          "options": [
            {
              "value": "a",
              "label": "A"
            },
            {
              "value": "other",
              "label": "その他"
            }
          ]
        },
        {
          "key": "late",
          "type": "text",
          "label": "late",
          "required": false,
          "visibleWhen": {
            "field": "d",
            "operator": "gte",
            "value": "2026-10-01"
          }
        },
        {
          "key": "morning",
          "type": "text",
          "label": "morning",
          "required": false,
          "visibleWhen": {
            "field": "t",
            "operator": "lt",
            "value": "12:00:00"
          }
        },
        {
          "key": "other_text",
          "type": "text",
          "label": "other_text",
          "required": false,
          "visibleWhen": {
            "field": "c",
            "operator": "contains",
            "value": "other"
          }
        },
        {
          "key": "none",
          "type": "text",
          "label": "none",
          "required": false,
          "visibleWhen": {
            "field": "c",
            "operator": "isEmpty"
          }
        }
      ],
      "submit": {
        "label": "送信する"
      },
      "success": {
        "mode": "message",
        "message": "お問い合わせを受け付けました。"
      },
      "mail": {
        "notification": {
          "to": [
            "owner@example.jp"
          ],
          "subject": "【お問い合わせ】{{form.name}}",
          "body": "{{submission.answers}}"
        },
        "thankYou": {
          "enabled": false
        }
      }
    },
    "values": {
      "d": "2026-10-07",
      "t": "09:30",
      "c": [
        "other"
      ]
    },
    "active": [
      "d",
      "t",
      "c",
      "late",
      "morning",
      "other_text"
    ],
    "required": []
  },
