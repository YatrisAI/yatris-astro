  {
    "warnings": [],
    "name": "malformed conditions",
    "declaration": {
      "contractVersion": 1,
      "key": "contact",
      "name": "お問い合わせ",
      "locale": "ja",
      "fields": [
        {
          "key": "kind",
          "type": "radio",
          "label": "kind",
          "required": false,
          "options": [
            {
              "value": "a",
              "label": "a"
            },
            {
              "value": "b",
              "label": "b"
            }
          ]
        },
        {
          "key": "x",
          "type": "text",
          "label": "x",
          "required": false,
          "visibleWhen": {
            "field": "kind"
          }
        },
        {
          "key": "y",
          "type": "text",
          "label": "y",
          "required": false,
          "visibleWhen": {
            "foo": 1
          }
        },
        {
          "key": "z",
          "type": "text",
          "label": "z",
          "required": false,
          "visibleWhen": {
            "field": "kind",
            "operator": "between",
            "value": "a"
          }
        }
      ],
      "submit": {
        "label": "送信する"
      },
      "success": {
        "mode": "message",
        "message": "お問い合わせを受け付けました。"
      },
      "mail": {
        "notification": {
          "to": [
            "owner@example.jp"
          ],
          "subject": "【お問い合わせ】{{form.name}}",
          "body": "{{submission.answers}}"
        },
        "thankYou": {
          "enabled": false
        }
      }
    },
    "errors": [
