[
  {
    "options": {},
    "name": "normalization of text-like values",
    "declaration": {
      "contractVersion": 1,
      "key": "contact",
      "name": "お問い合わせ",
      "locale": "ja",
      "fields": [
        {
          "key": "name",
          "type": "text",
          "label": "name",
          "required": false
        },
        {
          "key": "message",
          "type": "textarea",
          "label": "m",
          "required": false
        },
        {
          "key": "mail",
          "type": "email",
          "label": "mail",
          "required": false
        },
        {
          "key": "tel",
          "type": "tel",
          "label": "tel",
          "required": false
        },
        {
          "key": "n",
          "type": "number",
          "label": "n",
          "required": false
        }
      ],
      "submit": {
        "label": "送信する"
      },
      "success": {
        "mode": "message",
        "message": "お問い合わせを受け付けました。"
      },
      "mail": {
        "notification": {
          "to": [
            "owner@example.jp"
          ],
          "subject": "【お問い合わせ】{{form.name}}",
          "body": "{{submission.answers}}"
        },
        "thankYou": {
          "enabled": false
        }
      }
    },
    "input": {
      "answers": {
        "name": "　山田 太郎 ",
        "message": "一行目\r\n二行目\r三行目",
        "mail": "ｔａｒｏ＠ｅｘａｍｐｌｅ．ｊｐ",
        "tel": "０３－１２３４－５６７８",
        "n": "００７.５０"
      }
    },
    "expected": {
      "files": {},
      "answers": {
        "name": "山田 太郎",
        "message": "一行目\n二行目\n三行目",
        "mail": "taro@example.jp",
        "tel": "03-1234-5678",
        "n": "7.5"
      },
      "fieldErrors": {},
      "formErrors": []
    }
  },
