  {
    "options": {},
    "name": "inactive answers are dropped without validation",
    "declaration": {
      "contractVersion": 1,
      "key": "contact",
      "name": "お問い合わせ",
      "locale": "ja",
      "fields": [
        {
          "key": "customer_type",
          "type": "radio",
          "label": "customer_type",
          "required": true,
          "options": [
            {
              "value": "individual",
              "label": "individual"
            },
            {
              "value": "business",
              "label": "business"
            }
          ]
        },
        {
          "key": "company",
          "type": "text",
          "label": "company",
          "required": true,
          "visibleWhen": {
            "field": "customer_type",
            "operator": "eq",
            "value": "business"
          }
        },
        {
          "key": "department",
          "type": "text",
          "label": "department",
          "required": false,
          "visibleWhen": {
            "field": "company",
            "operator": "isNotEmpty"
          }
        }
      ],
      "submit": {
        "label": "送信する"
      },
      "success": {
        "mode": "message",
        "message": "お問い合わせを受け付けました。"
      },
      "mail": {
        "notification": {
          "to": [
            "owner@example.jp"
          ],
          "subject": "【お問い合わせ】{{form.name}}",
          "body": "{{submission.answers}}"
        },
        "thankYou": {
          "enabled": false
        }
      }
    },
    "input": {
      "answers": {
        "customer_type": "individual",
        "company": "",
        "department": "営業"
      }
    },
    "expected": {
      "files": {},
      "answers": {
        "customer_type": "individual"
      },
      "fieldErrors": {},
      "formErrors": []
    }
  },
