{
  "name": "@yatris/astro",
  "version": "0.4.0",
  "description": "Yatris Astro integration, build contract and the yatris CLI for Yatris-managed websites.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YatrisAI/yatris-astro.git",
    "directory": "packages/astro"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./delivery": {
      "types": "./dist/delivery.d.ts",
      "default": "./dist/delivery.js"
    },
    "./head": {
      "types": "./dist/head.d.ts",
      "default": "./dist/head.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "default": "./dist/navigation.js"
    },
    "./platform-lock": {
      "types": "./dist/platform-lock.d.ts",
      "default": "./dist/platform-lock.js"
    },
    "./platform": {
      "types": "./dist/platform.d.ts",
      "default": "./dist/platform.js"
    },
    "./measurement": {
      "types": "./dist/measurement.d.ts",
      "default": "./dist/measurement.js"
    },
    "./pairing": {
      "types": "./dist/pairing.d.ts",
      "default": "./dist/pairing.js"
    },
    "./forms": {
      "types": "./dist/forms/index.d.ts",
      "default": "./dist/forms/index.js"
    },
    "./forms/client": {
      "types": "./dist/forms-client/index.d.ts",
      "default": "./dist/forms-client/index.js"
    },
    "./forms/preview": {
      "types": "./dist/forms-client/preview.d.ts",
      "default": "./dist/forms-client/preview.js"
    },
    "./forms/mount": {
      "types": "./dist/forms-mount.d.ts",
      "default": "./dist/forms-mount.js"
    },
    "./contracts/forms/v1/*": "./contracts/forms/v1/*",
    "./YatrisHead.astro": "./components/YatrisHead.astro",
    "./YatrisForm.astro": "./components/YatrisForm.astro",
    "./YatrisBodyStart.astro": "./components/YatrisBodyStart.astro",
    "./virtual": {
      "types": "./components/virtual.d.ts"
    }
  },
  "bin": {
    "yatris": "./dist/cli.js"
  },
  "yatrisPlatform": {
    "status": "unreleased"
  },
  "files": [
    "dist",
    "components",
    "platform.json",
    "template",
    "skills",
    "contracts"
  ],
  "peerDependencies": {
    "astro": "^7.3.5"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node ../../scripts/stage-package.mjs . --with-assets && tsc -p tsconfig.build.json"
  },
  "publishConfig": {
    "access": "public"
  }
}
