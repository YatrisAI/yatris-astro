{
  "name": "@yatris/astro",
  "version": "0.0.0",
  "description": "Yatris Astro integration, build contract and the yatris CLI for Yatris-managed websites.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YatrisAI/yatris-astro.git",
    "directory": "packages/astro"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./delivery": {
      "types": "./dist/delivery.d.ts",
      "default": "./dist/delivery.js"
    },
    "./head": {
      "types": "./dist/head.d.ts",
      "default": "./dist/head.js"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "default": "./dist/navigation.js"
    },
    "./platform": {
      "types": "./dist/platform.d.ts",
      "default": "./dist/platform.js"
    },
    "./YatrisHead.astro": "./components/YatrisHead.astro",
    "./YatrisBodyStart.astro": "./components/YatrisBodyStart.astro",
    "./virtual": {
      "types": "./components/virtual.d.ts"
    }
  },
  "bin": {
    "yatris": "./dist/cli.js"
  },
  "files": [
    "dist",
    "components",
    "platform.json"
  ],
  "peerDependencies": {
    "astro": "^7.3.5"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node ../../scripts/stage-package.mjs . && tsc -p tsconfig.build.json"
  },
  "publishConfig": {
    "access": "public"
  }
}
