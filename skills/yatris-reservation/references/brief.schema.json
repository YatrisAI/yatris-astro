{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Yatris reservation interview brief, version 1",
  "description": "src/reservations/<key>.brief.json: the resumable record of a reservation-setup interview. Non-secret: it never holds credentials, recipient addresses, booking records or visitor data. Business facts (hosts, practitioners, tables, hours, capacity, durations, locations, confirmation policy) are confirmed or unresolved, never delegated; a delegated proposed default carries proposedDefault: true.",
  "type": "object",
  "required": ["briefVersion", "setup", "stage", "decisions"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "maxLength": 500 },
    "briefVersion": { "const": 1 },
    "setup": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "stage": { "enum": ["interviewing", "reviewed", "implemented"] },
    "updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "decisions": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$", "maxLength": 100 },
      "properties": {
        "mode.flow": { "allOf": [{ "$ref": "#/$defs/decision" }, { "properties": { "value": { "enum": ["time_slot", "business_service", "business_party"] } } }] },
        "confirmation.mode": { "allOf": [{ "$ref": "#/$defs/fact" }, { "properties": { "value": { "enum": ["automatic", "manual"] } } }] },
        "placement.existing": { "$ref": "#/$defs/fact" },
        "appointment.duration": { "$ref": "#/$defs/fact" },
        "hosts.list": { "$ref": "#/$defs/fact" },
        "hosts.strategy": { "allOf": [{ "$ref": "#/$defs/fact" }, { "properties": { "value": { "enum": ["single", "one_available"] } } }] },
        "services.list": { "$ref": "#/$defs/fact" },
        "practitioners.list": { "$ref": "#/$defs/fact" },
        "services.requirements": { "$ref": "#/$defs/fact" },
        "party.size_limits": { "$ref": "#/$defs/fact" },
        "party.duration": { "$ref": "#/$defs/fact" },
        "party.strategy": { "allOf": [{ "$ref": "#/$defs/fact" }, { "properties": { "value": { "enum": ["pool", "tables"] } } }] },
        "party.tables": { "$ref": "#/$defs/fact" },
        "party.capacity": { "$ref": "#/$defs/fact" },
        "hours.weekly": { "$ref": "#/$defs/fact" },
        "hours.exceptions": { "$ref": "#/$defs/fact" },
        "hours.resources": { "$ref": "#/$defs/fact" },
        "locations.list": { "$ref": "#/$defs/fact" },
        "calendar.maintenance": { "$ref": "#/$defs/fact" },
        "embed.origins": { "$ref": "#/$defs/fact" },
        "appointment.buffers": { "$ref": "#/$defs/defaulted" },
        "services.buffers": { "$ref": "#/$defs/defaulted" },
        "party.buffer": { "$ref": "#/$defs/defaulted" },
        "hours.timezone": { "$ref": "#/$defs/defaulted" },
        "policy.slot_interval": { "$ref": "#/$defs/defaulted" },
        "policy.horizon": { "$ref": "#/$defs/defaulted" },
        "policy.lead_time": { "$ref": "#/$defs/defaulted" },
        "policy.hold": { "$ref": "#/$defs/defaulted" },
        "confirmation.approval_window": { "$ref": "#/$defs/defaulted" },
        "cutoffs.cancel": { "$ref": "#/$defs/defaulted" },
        "cutoffs.reschedule": { "$ref": "#/$defs/defaulted" },
        "reminder.timing": { "$ref": "#/$defs/defaulted" },
        "theme.tokens": { "allOf": [{ "$ref": "#/$defs/decision" }, { "properties": { "value": { "$ref": "#/$defs/themeTokens" } } }] }
      },
      "additionalProperties": { "$ref": "#/$defs/decision" }
    },
    "pending": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "pairing",
          "operating_facts",
          "recipient_setup",
          "yatris_import",
          "staff_review",
          "staff_publication",
          "embedding_origins",
          "mail_setup",
          "provider_integration",
          "privacy_page"
        ]
      }
    }
  },
  "$defs": {
    "noAddress": {
      "description": "No recipient or other email address anywhere in a decision: business recipients are set by the Website Owner in Yatris, never in the repository.",
      "not": {
        "anyOf": [
          { "type": "string", "pattern": "[^\\s@]+@[^\\s@]+\\.[^\\s@]+" },
          { "type": "array", "contains": { "type": "string", "pattern": "[^\\s@]+@[^\\s@]+\\.[^\\s@]+" } }
        ]
      }
    },
    "decision": {
      "type": "object",
      "required": ["topic", "status", "summary"],
      "additionalProperties": false,
      "properties": {
        "topic": {
          "enum": [
            "booking_mode",
            "durations_resources",
            "hours_exceptions",
            "confirmation_policy",
            "locations_conferencing",
            "questions_recipients",
            "cutoffs_copy",
            "theme_embedding",
            "review"
          ]
        },
        "status": { "enum": ["confirmed", "delegated", "unresolved"] },
        "summary": { "allOf": [{ "type": "string", "minLength": 1, "maxLength": 1000 }, { "$ref": "#/$defs/noAddress" }] },
        "value": { "$ref": "#/$defs/noAddress" },
        "recommendation": { "$ref": "#/$defs/noAddress" },
        "proposedDefault": { "type": "boolean" },
        "source": { "enum": ["user", "repository", "yatris"] },
        "note": { "allOf": [{ "type": "string", "maxLength": 2000 }, { "$ref": "#/$defs/noAddress" }] }
      },
      "if": { "properties": { "status": { "const": "unresolved" } } },
      "then": { "not": { "required": ["value"] } },
      "else": { "required": ["value", "source"] }
    },
    "fact": {
      "description": "A business fact: confirmed by the user, the repository or Yatris, or unresolved. Never delegated and never a proposed default.",
      "allOf": [
        { "$ref": "#/$defs/decision" },
        { "properties": { "status": { "enum": ["confirmed", "unresolved"] }, "proposedDefault": { "const": false } } }
      ]
    },
    "defaulted": {
      "description": "A setting with a proposed engineering default (spec §3, decisions §13). Delegating it records the default with proposedDefault: true, so it is never mistaken for a business fact.",
      "allOf": [
        { "$ref": "#/$defs/decision" },
        {
          "if": { "properties": { "status": { "const": "delegated" } } },
          "then": { "required": ["proposedDefault"], "properties": { "proposedDefault": { "const": true } } }
        }
      ]
    },
    "themeTokens": {
      "description": "Theme tokens for <ReservationEmbed> (theme contract, YatrisCMS#421). The component validates the values; the brief only records which tokens were chosen.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary": { "type": "string", "minLength": 1, "maxLength": 100 },
        "onPrimary": { "type": "string", "minLength": 1, "maxLength": 100 },
        "background": { "type": "string", "minLength": 1, "maxLength": 100 },
        "surface": { "type": "string", "minLength": 1, "maxLength": 100 },
        "text": { "type": "string", "minLength": 1, "maxLength": 100 },
        "mutedText": { "type": "string", "minLength": 1, "maxLength": 100 },
        "border": { "type": "string", "minLength": 1, "maxLength": 100 },
        "error": { "type": "string", "minLength": 1, "maxLength": 100 },
        "focus": { "type": "string", "minLength": 1, "maxLength": 100 },
        "fontFamily": { "type": "string", "minLength": 1, "maxLength": 300 },
        "headingFontFamily": { "type": "string", "minLength": 1, "maxLength": 300 },
        "spacing": { "enum": ["compact", "comfortable", "spacious"] },
        "radius": { "type": "integer", "minimum": 0, "maximum": 24 }
      }
    }
  }
}
