{
  "name": "yatris-astro-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/astro",
    "packages/create-yatris"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "smoke": "node scripts/smoke-pack.mjs",
    "e2e": "node scripts/e2e-scaffold.mjs",
    "check": "npm run build && npm test && npm run smoke",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "22.20.4",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
